# ── Sensitive Config ─────────────────────────────────────────────
.env

# ── Tables Config (contains your actual table names) ─────────────
config/tables.conf
tables.conf
table.conf

# ── Backup Files ─────────────────────────────────────────────────
# Dumps produced by the tool. The negations keep source-controlled SQL
# (migrations, test fixtures) tracked — without them `*.sql` silently swallows
# the schema this project is built on.
*.sql
*.sql.gz
!engine/migrations/*.sql
!tests/fixtures/**/*.sql
backups/
logs/

# ── Test SSH keys ────────────────────────────────────────────────
# Generated on demand for the sshd test container. Never commit a private key,
# even a throwaway one — it trips secret scanners and teaches a bad habit.
tests/fixtures/ssh/

# ── Rust ─────────────────────────────────────────────────────────
target/

# ── Node / frontend build output ─────────────────────────────────
node_modules/
apps/desktop/dist/
apps/desktop/src-tauri/gen/

# ── Bundled CLI ──────────────────────────────────────────────────
# `npm run bundle:cli` stages a compiled dbsync here for Tauri to pick up as an
# external binary. Build output, not source; committing a binary would also go
# stale silently against the engine it was built from.
apps/desktop/src-tauri/binaries/

# ── Signing material ─────────────────────────────────────────────
# Nothing here should ever be committed. Certificates and the updater's private
# key belong in the OS keychain or in CI secrets.
*.p12
*.cer
*.mobileprovision
.tauri/

# ── macOS ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editors ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────────
*.log
